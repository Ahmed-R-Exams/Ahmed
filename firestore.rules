rules_version = '2';

// ============================================================
// قواعد أمان Firestore — يجب رفعها من Firebase Console
// (Firestore Database > Rules) أو عبر Firebase CLI:
//   firebase deploy --only firestore:rules
//
// المشروع لم يكن يحتوي على أي ملف قواعد، ما يعني أن قاعدة البيانات
// كانت غالبًا تعمل بقواعد افتراضية (إما مفتوحة بالكامل أثناء
// التطوير، أو مغلقة بالكامل) — كلاهما غير مناسب لمنصة إنتاجية.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // الامتحانات: القراءة متاحة للجميع (الطلاب يحتاجون فتحها بدون
    // تسجيل دخول)، لكن الإضافة/التعديل/الحذف مسموح فقط للمعلم
    // المسجّل دخوله عبر Firebase Auth.
    match /exams/{examId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // النتائج: أي طالب يقدر "يُنشئ" نتيجة (تسليم امتحانه)، لكن ما
    // حدش يقدر يقرأ نتائج غيره، أو يعدّل/يحذف أي نتيجة إلا المعلم.
    //
    // ملاحظة مهمة: صفحة الامتحان (exam.js) فيها تحقق "هل سبق للطالب
    // تأدية هذا الامتحان؟" يعتمد على قراءة كل النتائج من المتصفح.
    // بهذه القواعد الأكثر أمانًا، هذه القراءة سترفض لغير المسجلين
    // دخولهم (الطلاب لا يسجلون دخول إطلاقًا)، فيسقط الكود تلقائيًا
    // (try/catch موجود بالفعل) إلى الفحص المحلي فقط عبر localStorage
    // — وهو تنازل مقصود: كشف كل أسماء ودرجات الطلاب للعامة أسوأ من
    // إضعاف فحص "محاولة واحدة" جزئيًا. للحصول على الحماية الكاملة
    // للطرفين معًا، يلزم نقل هذا الفحص لخدمة خلفية (Cloud Function)
    // كما هو موضّح في README-SECURITY.md المرفق.
    match /results/{resultId} {
      allow create: if request.resource.data.keys().hasAll(
        ['studentName', 'examTitle', 'score', 'total']
      );
      allow read, update, delete: if request.auth != null;
    }
  }
}
